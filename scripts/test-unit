#!/usr/bin/env python3
"""Run item, serialization, file, API and UI tests without InfluxDB or Docker."""
import os
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parent.parent
env = dict(os.environ, CHIPI_TEST_ROOT=str(root) + '/', CHIPI_TEST_SUITE='unit')
raise SystemExit(subprocess.run(
    ['sbcl', '--noinform', '--no-userinit', '--non-interactive',
     '--load', str(root / 'scripts/run-tests.lisp')], cwd=root, env=env).returncode)
