#!/usr/bin/env python3
"""Run Chipi tests against a disposable InfluxDB v2 instance."""
import argparse
import json
import os
from pathlib import Path
import secrets
import subprocess
import urllib.parse
import urllib.request
import uuid

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--suite', choices=('influx', 'all'), default='influx')
    args = parser.parse_args()
    env = os.environ.copy()
    env.update(CHIPI_TEST_PASSWORD=secrets.token_hex(24),
               CHIPI_TEST_INFLUX_TOKEN=secrets.token_hex(32),
               CHIPI_TEST_INFLUX_ORG='chipi-tests',
               CHIPI_TEST_INFLUX_BUCKET='chipi-tests',
               CHIPI_TEST_SUITE=args.suite,
               CHIPI_TEST_ROOT=str(ROOT) + '/')
    compose = ['docker', 'compose', '-p', 'chipi-test-' + uuid.uuid4().hex[:12],
               '-f', str(ROOT / 'test/influx/compose.yaml')]
    result = 1
    try:
        subprocess.run(compose + ['up', '-d', '--wait', '--wait-timeout', '120'],
                       env=env, cwd=ROOT, check=True)
        port = subprocess.check_output(compose + ['port', 'influxdb', '8086'],
                                       env=env, text=True).strip().rsplit(':', 1)[1]
        env['CHIPI_TEST_INFLUX_URL'] = 'http://127.0.0.1:' + port
        request = urllib.request.Request(
            env['CHIPI_TEST_INFLUX_URL'] + '/api/v2/buckets?' +
            urllib.parse.urlencode({'name': env['CHIPI_TEST_INFLUX_BUCKET']}),
            headers={'Authorization': 'Token ' + env['CHIPI_TEST_INFLUX_TOKEN']})
        with urllib.request.urlopen(request, timeout=5) as response:
            if len(json.load(response)['buckets']) != 1:
                raise RuntimeError('Test bucket was not initialized')
        print('InfluxDB ready at ' + env['CHIPI_TEST_INFLUX_URL'], flush=True)
        result = subprocess.run(['sbcl', '--noinform', '--no-userinit', '--non-interactive',
                                 '--load', str(ROOT / 'scripts/run-tests.lisp')],
                                cwd=ROOT, env=env).returncode
    except (OSError, RuntimeError, subprocess.SubprocessError):
        print('InfluxDB test setup failed.', flush=True)
    finally:
        if result:
            subprocess.run(compose + ['logs', '--no-color', '--tail', '100'], env=env)
        cleanup = subprocess.run(compose + ['down', '--volumes', '--remove-orphans'], env=env)
        if cleanup.returncode and not result:
            result = cleanup.returncode
    return result


if __name__ == '__main__':
    raise SystemExit(main())
