(in-package #:chipi.binding.mqtt)

(defun run-mqtt-integration (&key (broker "mosquitto") (port (+ 30000 (random 10000))))
  "Exercise real QoS 1 delivery and reconnect against an isolated local broker."
  (let ((process nil) (input nil) (worker nil) (watchdog nil)
        (first-count 0) (second-count 0) (first-json nil)
        (counts-lock (bt2:make-lock :name "mqtt-integration-counts")))
    (labels ((start-broker ()
               (setf process
                     (uiop:launch-program (list broker "-p" (princ-to-string port))
                                          :output :stream :error-output :output)))
             (stop-broker ()
               (when process
                 (uiop:terminate-process process)
                 (uiop:wait-process process)
                 (setf process nil)))
             (await (predicate description)
               (loop repeat 160 when (funcall predicate) return t do (sleep 0.05)
                     finally (error "Integration condition failed: ~A" description)))
             (count-is (first second)
               (bt2:with-lock-held (counts-lock)
                 (and (= first-count first) (= second-count second)))))
      (unwind-protect
           (progn
             (assert (null *mqtt-input*))
             (start-broker)
             (setf input (mqtt-init :host "127.0.0.1" :port port)
                   worker (mqtt-input-thread input)
                   watchdog (mqtt-input-watchdog input))
             (assert (eq input (mqtt-init :host "127.0.0.1" :port port)))
             (assert (eq worker (mqtt-input-thread input)))
             (await (lambda () (gethash "connected" (mqtt-health-snapshot))) "connect")
             (let ((first (mqtt-subscribe "chipi/integration"
                                         (lambda (topic payload)
                                           (declare (ignore topic))
                                           (bt2:with-lock-held (counts-lock)
                                             (setf first-json (jzon:parse payload))
                                             (incf first-count)))))
                   (second (mqtt-subscribe "chipi/integration"
                                          (lambda (topic payload)
                                            (declare (ignore topic payload))
                                            (bt2:with-lock-held (counts-lock)
                                              (incf second-count))))))
               (await (lambda ()
                        (bt2:with-lock-held ((mqtt-input-lock input))
                          (member "chipi/integration" (mqtt-input-broker-topics input)
                                  :test #'string=))) "shared subscription")
               (sleep 0.15)
               (assert (eq :acknowledged
                           (mqtt-publish-confirmed
                            "chipi/integration"
                            (alexandria:plist-hash-table
                             (list "state" t "alarm" nil "null" 'cl:null) :test #'equal))))
               (await (lambda () (count-is 1 1)) "both consumers")
               (assert (eq t (gethash "state" first-json)))
               (assert (null (gethash "alarm" first-json)))
               (assert (nth-value 1 (gethash "alarm" first-json)))
               (assert (eq 'cl:null (gethash "null" first-json)))
               (mqtt-unsubscribe first)
               (assert (eq :acknowledged
                           (mqtt-publish-confirmed "chipi/integration" "second")))
               (await (lambda () (count-is 1 2)) "independent unsubscribe")
               (stop-broker)
               (await (lambda () (not (connected-p input))) "disconnect detection")
               (assert (handler-case
                           (progn (mqtt-publish-confirmed "chipi/integration" "offline") nil)
                         (mqtt-disconnected () t)))
               (start-broker)
               (await (lambda () (connected-p input)) "reconnect")
               (await (lambda ()
                        (bt2:with-lock-held ((mqtt-input-lock input))
                          (member "chipi/integration" (mqtt-input-broker-topics input)
                                  :test #'string=))) "subscription restoration")
               (sleep 0.15)
               (assert (eq :acknowledged
                           (mqtt-publish-confirmed "chipi/integration" "third")))
               (await (lambda () (count-is 1 3)) "delivery after restart")
               (mqtt-unsubscribe second))
             (mqtt-shutdown)
             (assert (null *mqtt-input*))
             (assert (not (bt2:thread-alive-p worker)))
             (assert (not (bt2:thread-alive-p watchdog)))
             (assert (null (mqtt-input-queue input)))
             (assert (null (mqtt-input-subscriptions input)))
             (format t "MQTT-INTEGRATION-PASS port=~A callbacks=~A/~A workers-joined=T~%"
                     port first-count second-count)
             t)
        (mqtt-shutdown)
        (stop-broker)))))
